{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\"",
    "build": "concurrently --raw \"npm run build --prefix apps/web\"",
    "start": "serve -s dist/apps/web -l $PORT",
    "lint": "concurrently --raw \"npm run lint --prefix apps/web\""
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "knip": "^6.32.1"
  },
  "dependencies": {
    "serve": "^14.2.0"
  },
  "workspaces": [
    "apps/*"
  ]
}
